DISCORD_TOKEN=your_discord_user_token_here
POKETWO_CHANNEL_ID=channel_id_where_pokemon_spawn
MESSAGE_CHANNEL_ID=channel_id_to_send_random_messages
NAMING_BOT_ID=bot_id_of_the_pokemon_naming_bot

# Auto captcha solver
# Free options (pick one):
#   - EZCaptcha: https://ez-captcha.com  (free credits on sign-up, recommended)
#   - Capsolver:  https://capsolver.com   (free credits on sign-up)
# Leave blank to disable auto-solving (bot will sleep and wait for manual "quaxly wake")
CAPTCHA_API_KEY=your_api_key_here

# Which captcha service to use: "ezcaptcha" or "capsolver" (default: capsolver)
CAPTCHA_SERVICE=ezcaptcha
